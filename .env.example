# cp .env.example .env  and fill this in.
# Optional -- without it the game runs fully local (see README).
ANTHROPIC_API_KEY=sk-ant-...

# --- models -----------------------------------------------------------------
# The artist is the stage worth spending on: it decides how good the sprite
# looks. Vision and chat are easy work, so keep those fast and cheap.
VISION_MODEL=claude-sonnet-5
ARTIST_MODEL=claude-opus-5
CHAT_MODEL=claude-haiku-4-5-20251001

# If a model name is ever rejected, every stage falls back to its local path
# rather than failing -- check the console for the actual API error.

# --- camera -----------------------------------------------------------------
# macOS built-in webcam is usually 0. Jetson USB cam: check `ls /dev/video*`.
CAM_INDEX=0

# --- window -----------------------------------------------------------------
SCREEN_W=1280
SCREEN_H=800

# --- offline ----------------------------------------------------------------
# OFFLINE=1 ignores the API key entirely. Use it to rehearse the demo exactly
# as it will run if the venue wifi dies.
OFFLINE=0

# Local dialogue when Claude is unreachable (optional).
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
