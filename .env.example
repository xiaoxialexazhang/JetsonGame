# cp .env.example .env  and fill this in.
# Optional -- without a key the game runs fully local (see README).

# --- api --------------------------------------------------------------------
# NVIDIA internal gateway (fronts Bedrock). Auth is a Bearer token.
INFERENCE_API_KEY='sk-...'
DEFAULT_ENDPOINT=https://inference-api.nvidia.com

# To use Anthropic directly instead, swap these two:
#   INFERENCE_API_KEY=sk-ant-api03-...
#   DEFAULT_ENDPOINT=https://api.anthropic.com

# Request shape. "auto" probes the endpoint once on first call and caches the
# answer. Pin it to openai / anthropic to skip the probe.
API_STYLE=auto

# --- models -----------------------------------------------------------------
# Every stage falls back to DEFAULT_MODEL, so this one line is enough to start.
DEFAULT_MODEL=aws/anthropic/bedrock-claude-opus-5

# Override per stage once you know what the endpoint offers. The artist is the
# stage worth spending on -- it decides how good the sprite looks. Vision and
# chat are easy work, so those want to be fast and cheap.
# Run `python3 tools/test_api.py --models` to list valid names.
#VISION_MODEL=aws/anthropic/bedrock-claude-sonnet-5
#ARTIST_MODEL=aws/anthropic/bedrock-claude-opus-5
#CHAT_MODEL=aws/anthropic/bedrock-claude-haiku-4-5

# If a model name is ever rejected, that stage falls back to its local path
# rather than failing -- check the console for the actual API error.

# --- camera -----------------------------------------------------------------
# macOS built-in webcam is usually 0. Jetson USB cam: check `ls /dev/video*`.
CAM_INDEX=0

# --- window -----------------------------------------------------------------
SCREEN_W=1280
SCREEN_H=800

# --- offline ----------------------------------------------------------------
# OFFLINE=1 ignores the API key entirely. Use it to rehearse the demo exactly
# as it will run if the venue wifi dies.
OFFLINE=0

# Local dialogue when the gateway is unreachable (optional).
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
